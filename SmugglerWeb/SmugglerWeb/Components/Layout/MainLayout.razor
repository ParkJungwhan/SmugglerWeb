@inherits LayoutComponentBase
@inject PageHeaderState Header

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

<FluentLayout Style="margin: 0px">
    <FluentHeader>@sitetitle</FluentHeader>

    <PageTitle>Smuggler - @Header.Title</PageTitle>

    <FluentStack Class="main" Orientation="Orientation.Horizontal">
        <NavMenu />
        <FluentBodyContent>
            <CascadingValue Value="_bcState">
                <div class="content">
                    @if (!_bcState.Hide)
                    {
                        <BreadcrumbComponents NameMap="_bcState.NameMap" Overrides="_bcState.Overrides" />
                    }
                    <PageHeader Title="@Header.Title" LatestDateTime="@Header.LatestDateTime" />
                    @Body
                </div>
            </CascadingValue>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter>
        <FluentLabel>
            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Mail())" />
            <a href="mailto:smug.kr@gmail.com">메일로 문의</a>
        </FluentLabel>

        <FluentSpacer />
        <FluentLabel>
            ⓒ pjh2104@gmail.com. 2025.
        </FluentLabel>
    </FluentFooter>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    string sitetitle = "SmugglerWeb";

    protected override void OnInitialized()
    {
        Header.OnChange += HandleChanged;
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Header.OnChange -= HandleChanged;
    }


    private BreadcrumbState _bcState = new(); // 모든 페이지와 공유되는 상태(수정 가능)
    public class BreadcrumbState
    {
        public bool Hide { get; set; } = false;
        public Dictionary<string, string> NameMap { get; } = new();
        public List<BreadcrumbComponents.BreadcrumbItem>? Overrides { get; set; }
    }
}