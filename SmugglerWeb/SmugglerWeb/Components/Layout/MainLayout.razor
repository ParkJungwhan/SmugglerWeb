@inherits LayoutComponentBase

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

<FluentLayout>
    <FluentHeader>
        @sitetitle
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />

        <FluentDivider Style="height: 420px;" Role="DividerRole.Presentation" Orientation="Orientation.Vertical"></FluentDivider>

        <FluentBodyContent Class="body-content">
            
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    

    <FluentFooter>
        <FluentLabel>
            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Mail())" />
            <a href="mailto:smug.kr@gmail.com">메일로 문의</a>
        </FluentLabel>
        
        <FluentSpacer />
        <FluentLabel>
            ⓒ pjh2104@gmail.com. 2025.
        </FluentLabel>
    </FluentFooter>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    string sitetitle = "SmugglerWeb";
}