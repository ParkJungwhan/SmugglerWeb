@page "/oilnet"
@using System.Diagnostics
@attribute [StreamRendering]

<!-- title -->
<PageTitle>Smuggler - Oil Net</PageTitle>

<!-- header -->
<FluentBreadcrumb>
    <FluentBreadcrumbItem Href="/">
        Home
        <FluentIcon Value="@(new Icons.Regular.Size16.Home())" Color="@Color.Neutral" Slot="start" />
    </FluentBreadcrumbItem>
    <FluentBreadcrumbItem Href="/about">
        About
        <FluentIcon Value="@(new Icons.Regular.Size16.Clipboard())" Color="@Color.Neutral" Slot="start" />
    </FluentBreadcrumbItem>
</FluentBreadcrumb>
<div>
    <FluentLabel Typo="Typography.H1"> @title</FluentLabel>
    <FluentSpacer />
    <FluentLabel Alignment="HorizontalAlignment.Right">Latest Time : @latestdatetime </FluentLabel>
</div>
<FluentDivider Style="width: 100%;" Role="DividerRole.Presentation"></FluentDivider>


<!-- main -->
<FluentBodyContent Loading="@(bVisible == false)">
    @* @if (bVisible)
    {
        <div>
            <FluentProgress></FluentProgress>
        </div>        
    } *@

    sss
    
</FluentBodyContent>

@code {
    string title = "유가 기록 조회 서비스";
    string latestdatetime = DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    bool bVisible = true;

    protected override async Task OnInitializedAsync()
    {
        Debug.WriteLine($"{DateTime.Now}\tSplash ----- Start");

        await Task.Delay(3000);

        bVisible = false;
        Debug.WriteLine($"{DateTime.Now}\tSplash ===== End");
    }
}